# Backend
APP_ID=dnd-wormsboard
APP_SECRET=replace-with-a-long-random-secret
HOST=0.0.0.0
PORT=3000

# Local installation. Docker Compose overrides these paths with /data/... .
SQLITE_PATH=./data/app.db
LOCAL_STORAGE_DIR=./data/uploads
DND_BACKUP_DIR=./data/backups
MEDIA_STORAGE_BACKEND=local

# Kept non-empty for the Kimi runtime adapter; SQLite does not use it.
DATABASE_URL=sqlite://local
